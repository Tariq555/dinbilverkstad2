{
  "name": "dinbilverkstad",
  "productName": "Din Bilverkstad",
  "version": "1.0.0",
  "description": "Däck- och lagerhanteringssystem för Din Bilverkstad — helt offline.",
  "author": "Din Bilverkstad",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/prepare-sqlite.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sqlite.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "node scripts/prepare-sqlite.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true
  }
}
